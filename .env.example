# Railway PostgreSQL (pool URL -- use ?connection_limit=5)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=5&sslmode=require"

# Direct connection -- bypasses PgBouncer, used only by prisma migrate dev
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# JWT secrets (generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET="changeme_generate_with_openssl_rand_hex_64"

# DEPRECATED -- refresh tokens are now opaque DB-stored tokens
# (see TokenService.createTokenPair). This variable is read by nothing in the
# codebase as of 2026-05-22 and is kept only for legacy .env compatibility.
# Safe to remove in a future cleanup.
JWT_REFRESH_SECRET="changeme_generate_with_openssl_rand_hex_64"

# Review system token secret (optional -- falls back to JWT_ACCESS_SECRET if unset)
REVIEW_TOKEN_SECRET=

# Seed admin (used once at first deploy)
SEED_ADMIN_EMAIL="admin@hotel.com"
SEED_ADMIN_PASSWORD="changeme_8_chars_min"
HOTEL_NAME="Hotel Sumapaz"
HOTEL_ADDRESS="Calle 123 #45-67, Bogotá"
HOTEL_PHONE="+57 1 555-0100"
HOTEL_TIMEZONE="America/Bogota"
IVA_RATE="0.19"

# Optional: override at seed time (YYYY-MM-DD). Defaults to current date in hotel timezone.
# HOTEL_BUSINESS_DATE="2026-05-13"

# ─── Email (Resend) — Phase 24/25 ─────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Hotel Sumapaz <reservas@hotel-sumapaz.com>"

# ─── Cloudflare R2 Photo Storage (Plan 02-02) ─────────────────────────────────
# Required for room photo upload via presigned URLs.
# NEVER commit actual credentials — populate in apps/api/.env (git-ignored).
#
# R2_ACCOUNT_ID    : Cloudflare Dashboard → R2 → Account ID (top right of R2 page)
# R2_ACCESS_KEY_ID : Cloudflare Dashboard → R2 → Manage R2 API Tokens → Create token
# R2_SECRET_ACCESS_KEY : Same token creation flow (shown once — copy immediately)
# R2_BUCKET        : Create bucket named hotel-rooms in R2 Dashboard
# R2_PUBLIC_URL    : Enable public access on bucket → r2.dev URL or custom domain
#                    Example: https://pub-abc123def456.r2.dev
#
# CORS rule required (Bucket Settings → CORS):
#   AllowedOrigins: http://localhost:5180  (add production origin at deploy time)
#   AllowedMethods: PUT
#   AllowedHeaders: *
#   MaxAgeSeconds: 600
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=hotel-rooms
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
