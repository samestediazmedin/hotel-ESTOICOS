# HotelOS AI — API environment variables
# Copy to .env and fill in real values before running.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/hoteldb

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── File Storage (Cloudflare R2) ──────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=hotel-photos
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxx
EMAIL_FROM=noreply@hotel.com

# ── Phase 5 — Housekeeping WebSocket ──────────────────────────────────────────
# Used for Socket.io CORS origin (separate from HTTP CORS in main.ts).
# Development: http://localhost:5173 (default if unset)
# Production:  https://hotel-frontend.up.railway.app
FRONTEND_URL=http://localhost:5173

# -- Staff AI Assistant (Phase 07) --
# OpenAI API key -- get from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model alias -- gpt-4o-mini is the cost-efficient default; override to gpt-4o without code change
OPENAI_MODEL=gpt-4o-mini
# Max conversation messages loaded into LLM context per turn (gpt-4o-mini has 128k window)
AI_MAX_HISTORY=20

# -- Concierge IA (Phase 08) --
# Hotel GPS coordinates for haversine distance computation (replace with real values).
# Bogota city center used as placeholder.
# Get real coords from Google Maps right-click > 'What''s here?'
HOTEL_LAT=4.6097
HOTEL_LNG=-74.0817
# Daily OpenAI token budget for the public concierge chatbot.
# At gpt-4o-mini pricing (~/usr/bin/bash.30-0.60/day at 1M tokens), this is a reasonable starting limit.
CONCIERGE_DAILY_TOKEN_LIMIT=1000000
# 32+ random chars -- REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONCIERGE_IP_HASH_SALT=

# -- Phase 14 — Public Reviews System --
# Separate secret for review invite JWTs (falls back to JWT_ACCESS_SECRET if unset).
# REQUIRED in production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVIEW_TOKEN_SECRET=
# Frontend origin — used to build review-invite links in emails.
# Production: https://your-hotel-frontend.up.railway.app
FRONTEND_BASE_URL=http://localhost:5173
